{
  "manifest_version": 3,
  "name": "More Slots · 更多快捷方式",
  "version": "1.3.1",
  "description": "熟悉的新标签页，自由设置快捷方式数量与列数，支持 Google 搜索联想和本机备份。",
  "permissions": [
    "storage",
    "favicon"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://suggestqueries.google.com"
  },
  "key": ""
}
